{
  "name": "dsh-mcd-mcp",
  "version": "0.2.0",
  "description": "McDonald's China MCP (mcp.mcd.cn) for DeepSeek Harness — paste your own token and every remote tool registers as a native DSH tool. 麦当劳中国 MCP 接入 DSH 插件。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-mcd-mcp",
    "mcd",
    "mcdonalds",
    "mcp",
    "mcp-client",
    "dsh"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "assets/",
    "README.md",
    "README.en.md",
    "README.zh-TW.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node scripts/check-secrets.mjs && node --test test/plugin.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepublishOnly": "node scripts/check-secrets.mjs && node --test test/plugin.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "大海君",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4KAForever11/dsh-mcd-mcp.git"
  },
  "homepage": "https://github.com/4KAForever11/dsh-mcd-mcp#readme",
  "bugs": {
    "url": "https://github.com/4KAForever11/dsh-mcd-mcp/issues"
  }
}
